# ========================================================
# PANKAJ DIXIT PORTFOLIO - SMTP CONFIGURATION TEMPLATE
# ========================================================

# Your Gmail address
EMAIL_USER=your_email@gmail.com

# 16-character Google App Password (generated from Google Account > Security > 2-Step Verification > App passwords)
EMAIL_PASS=your_16_character_app_password

# The email where website enquiries should be received
CONTACT_RECEIVER=your_email@gmail.com

# Backend Port
PORT=5000
